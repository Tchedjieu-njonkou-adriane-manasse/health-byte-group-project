# .env is loaded automatically when you run the app -- no need to set
# environment variables by hand.

HEALTHBYTE_SECRET_KEY=change-this-to-something-random

# Only needed if you want "Continue with Google" to work.
# See the "Setting up Google Sign-In" section in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if you want "Forgot password" to actually send emails.
# Without these, the reset link is shown directly on screen instead --
# handy for testing. See the "Setting up password reset emails" section
# in README.md.
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
ADMIN_EMAIL = 
